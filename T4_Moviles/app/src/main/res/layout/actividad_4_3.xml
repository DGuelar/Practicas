<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/padre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D6E4F0">

    <RelativeLayout
        android:id="@+id/hijo1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:background="#FFCC66" />

    <RelativeLayout
        android:id="@+id/hijo2"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="1dp"
        android:layout_marginRight="2dp"
        android:layout_toLeftOf="@id/hijo1"
        android:background="#E07856" />

    <RelativeLayout
        android:id="@+id/hijo3"
        android:layout_width="500dp"
        android:layout_height="300dp"
        android:layout_below="@id/hijo2"
        android:layout_alignParentRight="true"
        android:background="#9BC48A" />

    <RelativeLayout
        android:id="@+id/hijo4"
        android:layout_width="170dp"
        android:layout_height="500dp"
        android:layout_below="@id/hijo3"
        android:layout_alignParentLeft="true"
        android:background="#7B8AB8" />

    <RelativeLayout
        android:id="@+id/hijo5"
        android:layout_width="160dp"
        android:layout_height="100dp"
        android:layout_alignTop="@id/hijo4"
        android:layout_toRightOf="@id/hijo4"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:background="#FFCC66" />

</RelativeLayout>