<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlesBasicos">

        <!-- Pantalla de inicio (menú) -->
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Las cuatro pantallas de la Actividad 5.1 -->
        <activity android:name=".Caso1Activity" android:exported="false" />
        <activity android:name=".Caso2Activity" android:exported="false" />
        <activity android:name=".Caso3Activity" android:exported="false" />
        <activity android:name=".Caso4Activity" android:exported="false" />
        <activity android:name=".AnimacionesActivity" android:exported="false" />
        <activity android:name=".CasoListenerActivity" android:exported="false" />
        <activity android:name=".CasoOnClickActivity" android:exported="false" />
        <activity android:name=".Caso5_4Activity" android:exported="false" />
        <activity android:name=".Caso5_5Activity" android:exported="false" />
        <activity android:name=".Caso56Activity" android:exported="false" />

    </application>

</manifest>