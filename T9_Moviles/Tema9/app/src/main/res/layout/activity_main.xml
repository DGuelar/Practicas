<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANDROID AVANZADO"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1A237E"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn93"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9.3 — Fragmentos responsivos"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn95"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9.5 — Cronómetro con Handler"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn96"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9.6 — ScheduledThreadPoolExecutor"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn98"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9.8 — Cronómetro con BoundService"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn910"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9.10 — Broadcast receptor batería" />

    </LinearLayout>

</ScrollView>