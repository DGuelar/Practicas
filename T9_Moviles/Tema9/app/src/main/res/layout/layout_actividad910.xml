<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MONITOR DE SISTEMA"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ECEFF1"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de la batería"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBateria"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperando datos de batería..."
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escribe una URL para abrir:"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://www.google.com"
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEnviarBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ENVIAR BROADCAST Y ABRIR URL" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Al iniciar la app se mostrará un Toast con el estado de la batería."
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="24dp" />

</LinearLayout>